# Server port
PORT=3004

# Live Reload Server port
LIVE_RELOAD_PORT=3005

# SCHEDULER_DEBUG=1 — enables verbose scheduler tick/reschedule console output
SCHEDULER_DEBUG=1

# SHOW_DB_OPTIONS=1 — enables extra DB operations in settings
SHOW_DB_OPTIONS=1

# ─── Better Auth ───────────────────────────────────────────────────────────────
# Base URL of this server. Must match the redirect URI registered with Google.
# Change to your public domain when deployed (e.g. https://your-domain.com).
BETTER_AUTH_URL=http://localhost:3004

# ─── Google OAuth (optional — enables "Sign in with Google") ───────────────────
# Get these from: console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application) and add this redirect URI:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#
# CLIENT_ID:     Public identifier for your app, shown in the Google sign-in dialog
# CLIENT_SECRET:  Secret only your server knows — verifies the OAuth callback is genuine
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Twitter / X OAuth
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret


SKIP_AUTH=1
DEFAULT_USER_ID=   # optional, defaults to ''

